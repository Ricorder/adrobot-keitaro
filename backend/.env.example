# Скопировать в .env (файл не попадает в git) и заполнить.
DATABASE_URL=sqlite:///./adrobot.db

# Адрес тестового стенда из ТЗ
KEITARO_BASE_URL=https://tlgk.host
# Профиль -> API ключи -> Создать новый ключ
KEITARO_API_KEY=

# Все создаваемые кампании, группы и тестовые офферы получают этот префикс:
# на стенде одновременно работают другие кандидаты.
KEITARO_PREFIX=kolesnikov-

KEITARO_TIMEOUT_SECONDS=15
KEITARO_MAX_RETRIES=3
GOOGLE_REDIRECT_URL=https://www.google.com
